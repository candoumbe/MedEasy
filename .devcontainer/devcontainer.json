// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "MedEasy",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-bookworm",
	"features": {
		"ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3.0.0": {},
		"ghcr.io/devcontainers-extra/features/gh-cli:1": {},
		"ghcr.io/devcontainers/features/git:1.3.8": {},
		"ghcr.io/devcontainers/features/github-cli:1.1.2": {},
		"ghcr.io/devcontainers/features/copilot-cli:1.1.3": {},
		"ghcr.io/nils-geistmann/devcontainers-features/zsh": {
			"plugins": "git npm gh docker ng dotnet python"
		},
    "ghcr.io/devcontainers/features/dotnet": {
      "version": "10.0.401"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4.0.0": {
			"moby": true,
			"dockerDashComposeVersion": "v2"
		},
    "ghcr.io/va-h/devcontainers-features/uv": {
      "shellautocompletion": true
    }
	},
  "containerEnv": {
    "TESTCONTAINERS_RYUK_CONTAINER_PRIVILEGED": "false",
    "IS_DEVCONTAINER": "true"
  },
  
	"onCreateCommand": "bash ./.devcontainer/scripts/on-create.sh",
	"postCreateCommand": "bash ./.devcontainer/scripts/post-create.sh",
	"postStartCommand": "bash ./.devcontainer/scripts/post-start.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"angular.ng-template",
				"esbenp.prettier-vscode",
				"ms-azuretools.vscode-docker",
				"microsoft-aspire.aspire-vscode",
				"GitHub.copilot",
				"EditorConfig.EditorConfig",
				"mhutchie.git-graph",
				"zaaack.markdown-editor",
				"adrianwilczynski.user-secrets",
				"github.vscode-github-actions",
				"ms-python.python"
			],
			"settings": {
				"chat.tools.compressOutput.enabled": true,
				"chat.tools.riskAssessment.enabled": true,
				"chat.permissions.default": "autoApprove",
				"aspire.dashboardBrowser": "integratedBrowser",
				"aspire.closeDashboardOnDebugEnd": true,
        "remote.autoForwardPorts": true,
        "remote.autoForwardPortsSource": "process"
			}
		}
	},
	"runArgs": [
		"--privileged",
		"--env-file",
		"${localWorkspaceFolder}/.devcontainer/.env"
	]
}